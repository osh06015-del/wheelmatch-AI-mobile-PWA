# 복사해서 .env.local 로 쓴다. 이 파일에는 실제 값을 넣지 않는다.
#   cp .env.example .env.local
#
# .env* 는 .gitignore 대상이다 (.env.example 만 예외).
# 키가 어디로든 노출됐다면 즉시 교체한다 — 절차는 SECURITY.md.

# Phase 1 OCR — Anthropic Claude API 키 (서버 전용, 절대 커밋하지 않는다)
# src/app/api/extract/route.ts 에서만 읽는다.
ANTHROPIC_API_KEY=

# 사용할 모델. 비워두면 claude-sonnet-5 를 쓴다.
ANTHROPIC_MODEL=claude-sonnet-5

# OCR 엔진 선택: claude (기본) | tesseract
# 브라우저에서 읽어야 하므로 NEXT_PUBLIC_ 접두사가 필요하다. 비밀값이 아니다.
#
# 주의: NEXT_PUBLIC_ 이 붙은 값은 브라우저 번들에 그대로 들어간다.
# 비밀값에는 절대 이 접두사를 붙이지 않는다.
NEXT_PUBLIC_OCR_MODE=claude

# 연구 도구(CSV 내보내기·정답 파일·평가 지표). 비워두면 꺼짐 — 현장 배포판의 기본값.
# 정확히 true 일 때만 이력 화면에 연구 패널이 생긴다. 내부 검증 빌드에서만 켠다.
# 빌드할 때 번들에 박히므로 바꾸면 다시 빌드·배포해야 반영된다.
# 현장 배포(Vercel Production)에는 넣지 않는다. 비밀값이 아니다.
NEXT_PUBLIC_ENABLE_RESEARCH_TOOLS=
